[node name="InteragirDialogo[ESCRITORIO]2" type="Area2D" parent="." unique_id=1353880914]
position = Vector2(481, 536)
script = ExtResource("38_w7b66")
texts = Array[String](["Lembro de quando meu pai me ensinou a reconhecer as constelações.", "Eu não entendia muito sobre o universo.", "Naquela época, eu só me preocupava com as noites passarem rápido demais.", "Hoje, daria qualquer coisa para perder mais algumas horas ao lado dele."])

[node name="Sprite2D" type="Sprite2D" parent="InteragirDialogo[ESCRITORIO]2" unique_id=48917340]
