[node name="Label" type="Label" parent="InteragirDialogo[ESCRITORIO]3" unique_id=762093626]
offset_left = -4.0
offset_top = -32.0
offset_right = 36.0
offset_bottom = -9.0
text = "\"B\"/\"F\""

[node name="InteragirDialogo[ESCRITORIO]4" type="Area2D" parent="." unique_id=1070346027]
position = Vector2(1154, 537)
script = ExtResource("38_w7b66")
texts = Array[String](["Eu acreditava que meu pai sempre saberia encontrar o caminho.", "Para mim, ele tinha todas as respostas e era capaz de consertar qualquer coisa.", "Demorei a entender que nem tudo podia ser consertado, nem todos os caminhos permitiam uma volta.", "Passei tanto tempo ressentido por sua partida que me esqueci de tudo o que ele deixou em mim.", "Ainda não sei como voltar para ele, mas posso continuar seguindo seus ensinamentos."])

