offset_right = 36.0
offset_bottom = -9.0
text = "\"B\"/\"F\""

[node name="InteragirDialogo[ESCRITORIO]3" type="Area2D" parent="." unique_id=1524603285]
position = Vector2(946, 152)
script = ExtResource("38_w7b66")
texts = Array[String](["Meu pai dedicou a vida a manter essa luz acesa. ", "Quando criança, eu não entendia sua dedicação.", "Hoje, sei que ele fazia isso para guiar pessoas de volta para casa.", "Passou a vida orientando tantos, mas, quando partiu, deixou sua própria família à deriva."])

[node name="Sprite2D" type="Sprite2D" parent="InteragirDialogo[ESCRITORIO]3" unique_id=2127460759]
texture_filter = 1
