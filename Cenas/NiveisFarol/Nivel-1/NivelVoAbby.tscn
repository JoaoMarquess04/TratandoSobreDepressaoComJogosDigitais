[node name="InteragirDialogo[CARTA]" type="Area2D" parent="." unique_id=355635557]
position = Vector2(630, 574)
script = ExtResource("11_f4pxe")
texts = Array[String](["Uma das cartas que ele me mandava...", "\"Achei a foto que estava perdida no farol...\"", "\"A Katrina devia ter seus OITO anos na época dessa foto...", "\"Ou eram SETE?...\"", "\"De qualquer forma levarei a foto para você as CINCO.\"", "A letra dele ficava torta quando estava cansado.", "Eu reconheceria essas palavras em qualquer lugar.", "É estranho...", "...", "Um pedaço de papel conseguir pesar tanto."])

