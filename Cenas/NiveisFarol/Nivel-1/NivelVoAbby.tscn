[node name="InteragirDialogo[DISPENSA]" type="Area2D" parent="." unique_id=1697335997]
position = Vector2(563, 573)
script = ExtResource("11_f4pxe")
texts = Array[String](["Qualquer coisa que ocorria você vinha até aqui...", "Pegava o que precisava...", "E dizia:", "\"Se tivesse uma ferramenta e tempo suficiente...", "“...dava para consertar qualquer coisa.”", "Mas existem coisas que ninguém consegue salvar."])

