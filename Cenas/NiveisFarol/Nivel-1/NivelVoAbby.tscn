script = ExtResource("11_f4pxe")
texts = Array[String](["Esse relógio...", "Seu antigo relógio, nunca ficava sem ele.", "Apesar disso, você nunca acertava o horário...", "Vivia chegando atrasado...", "...", "Mas eu sempre ficava acordada esperando você voltar.", "Mãe aprende a esperar até quando não devia."])

